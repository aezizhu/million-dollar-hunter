# Server configuration
HTTP_PORT=8080

# JWT configuration
JWT_SECRET=change-this-in-production
JWT_EXPIRY_MINUTES=15

# Redis configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting (per user)
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Service endpoints (for future gRPC integration)
AUTH_SERVICE_ADDR=localhost:50051
PORTFOLIO_SERVICE_ADDR=localhost:50052
MARKET_DATA_SERVICE_ADDR=localhost:50053

# Observability
LOG_LEVEL=info

# CORS configuration
# Comma-separated list of allowed origins, or "*" to allow all (not recommended for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MVP credentials
MVP_USERNAME=aezi
MVP_PASSWORD=Aa@123456789
