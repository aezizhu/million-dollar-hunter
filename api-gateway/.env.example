PORT=8080
REDIS_URL=localhost:6379
# Auth mode retained for backward compat; prefer JWT validation with JWT_SECRET set
AUTH_MODE=mvp-gate
# MVP-only fallback credentials (leave empty in real environments)
ADMIN_USER=
ADMIN_PASS=
# Auth service base URL for proxying login/refresh, e.g. http://localhost:9000
AUTH_SERVICE_URL=
# Portfolio service gRPC address, e.g. localhost:50051
PORTFOLIO_SERVICE_URL=
# Market data service gRPC address, e.g. localhost:50052
MARKET_DATA_SERVICE_URL=
# ⚠️  SECURITY WARNING ⚠️
# gRPC connections currently use INSECURE transport (no TLS encryption).
# This is ONLY acceptable for:
#   - Local development (localhost connections)
#   - Internal networks with network-level security
#   - Kubernetes pod-to-pod with service mesh (Istio/Linkerd)
#
# For production deployments over untrusted networks:
#   - DO NOT use this configuration
#   - Implement TLS support (see TODO in internal/clients/grpc.go)
#   - Use mutual TLS (mTLS) for authentication
#
# TODO: Add environment variables for TLS:
#   GRPC_TLS_ENABLED=true
#   GRPC_CLIENT_CERT_PATH=/path/to/client.crt
#   GRPC_CLIENT_KEY_PATH=/path/to/client.key
#   GRPC_CA_CERT_PATH=/path/to/ca.crt
#
# HS256 secret used to validate JWTs at the gateway; if set, signature+exp are enforced
# JWT validation mode: local (validate in gateway) or grpc (delegate to auth-service)
AUTH_VALIDATE_MODE=local
# Required when AUTH_VALIDATE_MODE=grpc (e.g., localhost:9090 or auth-service:9090)
AUTH_GRPC_ADDR=
# Expected JWT audience when using gRPC mode
JWT_AUDIENCE=
# Timeout for gRPC auth validation in milliseconds (default 2000)
AUTH_GRPC_TIMEOUT_MS=2000
# When true, if gRPC validation fails, fallback to local validation if configured
AUTH_GRPC_FALLBACK_TO_LOCAL=false

JWT_SECRET=
# CORS origin for frontend, e.g. http://localhost:3000 (use * for dev only)
FRONTEND_URL=*
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_NAMESPACE=api_gateway
# Path to the OpenAPI spec for startup validation
OPENAPI_PATH=../docs/openapi.yaml
# Toggle strict validation failure behavior (true=fatal, false=warn)
STRICT_OPENAPI_VALIDATION=false
# Default rate limits; can be overridden per-route via ROUTE_LIMITS
RATE_DEFAULT_RPS=10
RATE_DEFAULT_BURST=20
# Optional per-route rate limits (JSON). Keys are route templates like /api/v1/portfolios
# Example: {"\/api\/v1\/portfolios":{"rps":5,"burst":10},"\/api\/v1\/wallets\/:address":{"rps":2,"burst":4}}
ROUTE_LIMITS=
# Security Headers
# Only enable HSTS when HTTPS is terminated at the edge (e.g., nginx/ALB)
ENABLE_HSTS=false
# Content Security Policy for API responses (optional)
# Example: default-src 'self'
CSP_POLICY=
