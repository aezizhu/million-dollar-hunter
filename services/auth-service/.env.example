PORT=8080
GRPC_PORT=9090
DATABASE_URL=postgres://postgres:postgres@localhost:5432/million_hunter?sslmode=disable
JWT_ISSUER=million-hunter
JWT_AUDIENCE=million-hunter-client
JWT_SIGNING_KEY=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
ENABLE_MULTI_USER=false
PASSWORD_MIN_LENGTH=12
LOCKOUT_AFTER_FAILS=5
LOCKOUT_WINDOW_MIN=15
LOCKOUT_DURATION_MIN=15

# MVP Mode Configuration (when ENABLE_MULTI_USER is not "true")
# MVP_PASSWORD must be a bcrypt hash (NOT plaintext).
# Generate with one of these methods:
#   Go: golang.org/x/crypto/bcrypt.GenerateFromPassword([]byte("yourpass"), 12)
#   CLI: htpasswd -nBC 12 "" | tr -d ':\n'
#   Online: https://bcrypt-generator.com (use cost 12)
MVP_USERNAME=admin
MVP_PASSWORD=$2a$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewY5GyB0GBPb1LHa  # Example hash for "password123"
