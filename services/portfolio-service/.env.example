# =============================================================================
# Portfolio Service Configuration
# =============================================================================
# This file documents all environment variables for the portfolio-service.
# Copy this file to .env and adjust values for your environment.
#
# The portfolio service:
# - Consumes transaction data from Kafka (published by ingestion-service)
# - Maintains portfolio state in PostgreSQL (CQRS read model)
# - Exposes gRPC API for portfolio queries and exports
#
# For local development, use the defaults below.
# For Docker Compose deployment, see ops/docker-compose.yml
# =============================================================================

# -----------------------------------------------------------------------------
# gRPC Server Configuration
# -----------------------------------------------------------------------------
# Address and port for the gRPC server to listen on
# Format: :port or host:port
# The API Gateway will connect to this endpoint
GRPC_ADDR=:8081

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://user:password@host:port/database?sslmode=...
# 
# SECURITY WARNING: The default credentials below are FOR DEVELOPMENT ONLY.
# For production:
# - Use strong, unique passwords
# - Enable SSL (sslmode=require or verify-full)
# - Store credentials in a secret manager (not in code/config)
# - Restrict database access by IP/network
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Database Connection Pool Settings
# Tune these based on your workload and database resources
# Higher values = more concurrent queries but more memory usage
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# Maximum lifetime of a connection before it's closed and recreated
# Prevents stale connections and helps with connection pooling at the database level
DB_MAX_CONN_LIFETIME=1h

# Maximum time a connection can be idle before being closed
# Helps free up resources when the service is not under load
DB_MAX_CONN_IDLE_TIME=30m

# How often to check connection health (ping the database)
# Lower values detect failures faster but add overhead
DB_HEALTH_CHECK_PERIOD=1m

# -----------------------------------------------------------------------------
# Kafka Configuration
# -----------------------------------------------------------------------------
# Kafka broker addresses (comma-separated list)
# For local development with docker-compose: localhost:9092
# For running inside Docker network: kafka:29092
# For production: list all brokers for redundancy
KAFKA_BROKERS=localhost:9092

# Kafka topic to consume transaction data ingested events
# Published by ingestion-service after fetching blockchain data
TOPIC_TRANSACTION_INGESTED=TransactionDataIngested

# Kafka topic to publish portfolio updated events (future use)
# Can be consumed by notification service, analytics, etc.
TOPIC_PORTFOLIO_UPDATED=PortfolioUpdated

# Kafka consumer group ID
# Multiple instances with the same group ID will share message processing
# Change this if you need separate consumer groups for different purposes
KAFKA_GROUP_ID=portfolio-service

# -----------------------------------------------------------------------------
# Market Data Service Configuration
# -----------------------------------------------------------------------------
# gRPC address of the market-data-service for price enrichment
# Format: host:port
# For local development: localhost:50051
# For Docker Compose: market-data-service:50051
MARKET_DATA_SERVICE_ADDR=localhost:50051

# RPC timeout for single token price lookups
# Controls how long to wait for GetTokenPrice calls
# Default: 5s (adjust based on market-data-service performance)
MARKET_DATA_SINGLE_TIMEOUT=5s

# RPC timeout for batch token price lookups
# Controls how long to wait for GetTokenPrices calls
# Should be higher than single timeout due to batch processing
# Default: 10s (adjust based on batch size and performance)
MARKET_DATA_BATCH_TIMEOUT=10s

# TLS Configuration for market-data-service (Production)
# Enable TLS for secure communication in production
# Default: false (insecure) for local development
MARKET_DATA_TLS_ENABLED=false

# Path to CA certificate file for verifying market-data-service
# Required if MARKET_DATA_TLS_ENABLED=true and using custom CA
# Leave empty to use system CA pool
# Example: /etc/ssl/certs/market-data-ca.pem
MARKET_DATA_CA_FILE=

# Server name to verify in TLS certificate (SNI)
# Required if MARKET_DATA_TLS_ENABLED=true
# Should match the CN or SAN in market-data-service certificate
# Example: market-data-service.prod.example.com
MARKET_DATA_SERVER_NAME=

# -----------------------------------------------------------------------------
# Export Configuration
# -----------------------------------------------------------------------------
# Directory where CSV and JSON portfolio exports will be saved
# Must be writable by the service user
# 
# NOTE: For stateless deployment, consider using:
# - Object storage (S3, GCS, Azure Blob)
# - Temporary files with streaming to client
# - In-memory generation and direct response
EXPORT_DIR=/data/exports

# -----------------------------------------------------------------------------
# Logging Configuration (PLANNED - NOT YET IMPLEMENTED)
# -----------------------------------------------------------------------------
# NOTE: These settings are reserved for future structured logging.
# Currently, the service uses Go's standard log package with fixed format.
#
# Log level: debug, info, warn, error (NOT YET FUNCTIONAL)
# Use 'debug' for local development, 'info' or 'warn' for production
LOG_LEVEL=info

# Log format: json or text (NOT YET FUNCTIONAL)
# Use 'json' for production (machine-readable, structured)
# Use 'text' for local development (human-readable)
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Observability Configuration (PLANNED - NOT YET IMPLEMENTED)
# -----------------------------------------------------------------------------
# NOTE: These settings are reserved for future instrumentation.
# Currently, the service has no metrics or tracing integration.
#
# OpenTelemetry Collector endpoint for distributed tracing (NOT YET FUNCTIONAL)
# Leave empty to disable tracing
# Example: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prometheus metrics namespace (NOT YET FUNCTIONAL)
# Metrics will be prefixed with this value (e.g., portfolio_service_requests_total)
PROMETHEUS_NAMESPACE=portfolio_service
