# gRPC Server Configuration
GRPC_ADDR=:8081

# PostgreSQL Database Connection
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Kafka Configuration
# Comma-separated list of broker addresses
KAFKA_BROKERS=localhost:9092

# Kafka Topics
# Topic to consume transaction data ingested events from ingestion-service
TOPIC_TRANSACTION_INGESTED=TransactionDataIngested

# Topic to publish portfolio updated events (future use)
TOPIC_PORTFOLIO_UPDATED=PortfolioUpdated

# Kafka Consumer Group ID
KAFKA_GROUP_ID=portfolio-service

# Export Directory
# Directory where CSV and JSON exports will be saved
EXPORT_DIR=/data/exports
